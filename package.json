{
  "name": "idespise-pdf",
  "version": "1.1.1",
  "private": true,
  "description": "Local-first PDF utilities. Files are processed in your browser and never uploaded.",
  "author": "z3dd77",
  "main": "electron/main.mjs",
  "scripts": {
    "predev": "node scripts/sync-pdf-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-pdf-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/sync-pdf-assets.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "smoke": "node scripts/smoke.mjs",
    "ui-smoke": "node scripts/ui-smoke.mjs",
    "build:static": "node scripts/build-static.mjs",
    "electron:bundle": "node scripts/build-electron.mjs",
    "electron:start": "npm run electron:bundle && node scripts/ensure-electron.mjs && electron .",
    "electron:smoke": "npm run electron:bundle && node scripts/ensure-electron.mjs && node scripts/electron-smoke.mjs",
    "dist:win": "npm run electron:bundle && node scripts/ensure-electron.mjs && npm run build:static && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
